# Copy to .env.local and fill in. Server variables never reach the browser.

# --- Read-aloud voice (app/api/tts) ---
# sarvam (default) | gemini | google | off
TTS_PROVIDER=sarvam
# Sarvam AI API key (dashboard.sarvam.ai). Server only.
SARVAM_API_KEY=
# bulbul:v4-flash (persona voices) or bulbul:v3 (short names). Speaker must match the model.
TTS_MODEL=bulbul:v4-flash
# v4-flash Marathi: ishita_mr_conversational, nilesh_mr_conversation, neha_mr_narration, soham_mr_narration, ...
# v3: rupali, soham, ritu, shubh, ...
TTS_SPEAKER_MR=ishita_mr_conversational
# optional, for Crop Check's Hindi
TTS_SPEAKER_HI=
# optional: Sarvam pronunciation dictionary id (v3 / v4-flash only)
SARVAM_DICT_ID=
# Gemini speech generation, used when TTS_PROVIDER=gemini. Uses GEMINI_API_KEY (same as Krishi Mitra chat).
GEMINI_API_KEY=
# gemini-3.8-flash-lite-tts (default, fastest), gemini-3.8-flash-tts, or gemini-2.5-flash-preview-tts
TTS_MODEL_GEMINI=gemini-3.8-flash-lite-tts
# a prebuilt voice: Kore (default), Aoede, Leda, Callirrhoe, Autonoe, Puck, Charon, ...
TTS_VOICE_GEMINI=Kore
# Google Cloud Text-to-Speech, used when TTS_PROVIDER=google
GOOGLE_TTS_API_KEY=
GOOGLE_TTS_VOICE=
# 1 = the app may use /api/tts (build time)
NEXT_PUBLIC_TTS_CLOUD=1
# optional: pre-generated clips on S3/CloudFront instead of /public/tts
NEXT_PUBLIC_TTS_STATIC_BASE=

# --- Mandi rates (app/api/mandi-prices) ---
# Free key from data.gov.in (sign up → My account → API key). Server only; without it the app
# shows sample rates, clearly marked "Sample rates (example)".
DATA_GOV_IN_API_KEY=
