# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel
.env*

# Python caches & virtual environments
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
backend/venv/
backend/.venv/
venv/
.venv/
ENV/
env/

# Python testing & coverage
.pytest_cache/
.coverage
htmlcov/

# Logs & security audit
*.log
security_audit.log
backend/security_audit.log
app.log

# Frontend build & caches
frontend/dist/
frontend/node_modules/
crop-check/dist/
crop-check/node_modules/

